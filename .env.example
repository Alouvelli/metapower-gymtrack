# Copier en .env et remplir. Générer les secrets avec : openssl rand -hex 32
# Ne JAMAIS commiter le .env (déjà ignoré par git).

DB_PASSWORD=
JWT_SECRET=
ADMIN_DEFAULT_PASSWORD=
DEVICE_ACCESS_KEY=

# Gmail : mot de passe d'application (compte Google → Sécurité → Mots de passe des applications)
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=

# Production : adresse publique HTTPS (liens WhatsApp, CORS). Sans domaine : <ip-avec-tirets>.sslip.io
DOMAIN=
APP_BASE_URL=https://${DOMAIN}
